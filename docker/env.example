# Template for ~/homelab/.env on the Docker VM.
# Copy to .env and replace the placeholder values. Never commit the real .env.

# --- General ---
TZ=America/Denver

# --- Pi-hole ---
PIHOLE_PASSWORD=change-me

# --- Homepage ---
# Address(es) used to open Homepage in the browser (comma-separated)
HOMEPAGE_ALLOWED_HOSTS=192.168.0.252:3000

# --- Minecraft ---
MC_MEMORY=8G
# Comma-separated Minecraft usernames
MC_WHITELIST=player1,player2
MC_OPS=player1

# --- playit.gg ---
# Secret key from the playit.gg dashboard. Anyone with this can run your tunnels.
PLAYIT_SECRET_KEY=your-playit-secret-key
